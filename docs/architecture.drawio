<mxfile host="app.diagrams.net"><diagram id="arch" name="Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1200" pageHeight="800" background="#fbf4e6" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Mythic Strings — system architecture&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="300" y="22" width="600" height="36" as="geometry"/></mxCell><mxCell id="client" value="Browser client  (Vite + TypeScript + PixiJS 8)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff9ef;strokeColor=#b5651d;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#b5651d;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="300" height="420" as="geometry"/></mxCell><mxCell id="server" value="Node.js 22 server  (one process)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff9ef;strokeColor=#9b2c2c;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#9b2c2c;container=0;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="380" height="420" as="geometry"/></mxCell><mxCell id="ai" value="AI &amp; memory services" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f8fc;strokeColor=#4a6fa5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#4a6fa5;container=0;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="300" height="420" as="geometry"/></mxCell><mxCell id="aws" value="AWS deployment  (npm run deploy:aws)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f6f9;strokeColor=#232f3e;strokeWidth=2;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#232f3e;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="1140" height="240" as="geometry"/></mxCell><mxCell id="render" value='&lt;b&gt;PixiJS renderer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;jointed leather puppets, stage, FX&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c58b4c;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="260" height="56" as="geometry"/></mxCell><mxCell id="duel" value='&lt;b&gt;Duel controller&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;practice · local 2-player · online&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c58b4c;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="50" y="178" width="260" height="56" as="geometry"/></mxCell><mxCell id="sim" value='&lt;b&gt;Shared 60 Hz combat sim&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;same engine runs on the server&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7c4;strokeColor=#d9822b;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="50" y="246" width="260" height="56" as="geometry"/></mxCell><mxCell id="forge" value='&lt;b&gt;Character forge + SVG atelier&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;text or sketch → garments, weapons&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c58b4c;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="50" y="314" width="260" height="56" as="geometry"/></mxCell><mxCell id="input" value='&lt;b&gt;Input · HUD · audio&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;keyboard, touch, 5-second mantra box&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c58b4c;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="50" y="382" width="260" height="56" as="geometry"/></mxCell><mxCell id="api" value='&lt;b&gt;HTTP API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;session, roster, summon, prompt, atelier, match&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0605a;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="340" height="56" as="geometry"/></mxCell><mxCell id="rooms" value='&lt;b&gt;WebSocket rooms (invite codes)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;authoritative sim, 30 Hz snapshots&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0605a;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="430" y="178" width="340" height="56" as="geometry"/></mxCell><mxCell id="orch" value='&lt;b&gt;AI orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;exact cache → Supermemory → Gemini → Bedrock&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;→ local rules · deadlines, rate &amp;amp; daily limits&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7c4;strokeColor=#d9822b;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="430" y="246" width="340" height="70" as="geometry"/></mxCell><mxCell id="safety" value='&lt;b&gt;Safety &amp;amp; ownership&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;SVG allow-list sanitizer · signed guest tokens&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0605a;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="430" y="328" width="340" height="56" as="geometry"/></mxCell><mxCell id="store" value='&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;JSON file locally · DynamoDB on AWS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0605a;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="430" y="396" width="340" height="56" as="geometry"/></mxCell><mxCell id="gemini" value='&lt;b&gt;Google Gemini  (primary)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;flash-lite: mantra → attack / defense&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;flash + Search: legend research&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;SVG garments &amp;amp; weapon art&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4a6fa5;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="890" y="110" width="260" height="92" as="geometry"/></mxCell><mxCell id="bedrock" value='&lt;b&gt;Amazon Bedrock  (fallback)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Claude Haiku 5.5 via Converse&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;classify · design · SVG · narrate&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e0;strokeColor=#d9822b;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="890" y="216" width="260" height="72" as="geometry"/></mxCell><mxCell id="smem" value='&lt;b&gt;Supermemory  (optional)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;semantic mantra cache&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;per-player duel chronicle&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0eefc;strokeColor=#6b5bb5;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="890" y="302" width="260" height="72" as="geometry"/></mxCell><mxCell id="local" value='&lt;b&gt;Built-in local lore&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;deterministic fallback, no keys needed&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="890" y="388" width="260" height="64" as="geometry"/></mxCell><mxCell id="cf" value='&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;public HTTPS + WSS URL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c4fff;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="250" height="70" as="geometry"/></mxCell><mxCell id="ec2" value='&lt;b&gt;Amazon EC2 t4g (ARM)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Node 22 + systemd · runs the server&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e07b00;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="300" height="70" as="geometry"/></mxCell><mxCell id="ddb" value='&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;characters · ranks · match records&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b48cc;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="790" y="580" width="250" height="70" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;private releases&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f8624;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="400" y="686" width="140" height="64" as="geometry"/></mxCell><mxCell id="ssm" value='&lt;b&gt;Systems Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;install, no SSH&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e7157b;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="560" y="686" width="140" height="64" as="geometry"/></mxCell><mxCell id="iam" value='&lt;b&gt;IAM instance role&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Bedrock + DynamoDB, no keys on box&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dd344c;strokeWidth=1.6;fontSize=13;fontColor=#3b2414;" vertex="1" parent="1"><mxGeometry x="790" y="686" width="250" height="64" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS /api" style="endArrow=block;endFill=1;html=1;strokeColor=#3b2414;strokeWidth=1.6;fontSize=11;fontColor=#3b2414;labelBackgroundColor=#fbf4e6;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="render" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="WSS /ws" style="endArrow=block;endFill=1;html=1;strokeColor=#3b2414;strokeWidth=1.6;fontSize=11;fontColor=#3b2414;labelBackgroundColor=#fbf4e6;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="duel" target="rooms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#3b2414;strokeWidth=1.6;fontSize=11;fontColor=#3b2414;labelBackgroundColor=#fbf4e6;exitX=1.000;exitY=0.343;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="gemini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#3b2414;strokeWidth=1.6;fontSize=11;fontColor=#3b2414;labelBackgroundColor=#fbf4e6;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="bedrock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#3b2414;strokeWidth=1.6;fontSize=11;fontColor=#3b2414;labelBackgroundColor=#fbf4e6;exitX=1.000;exitY=0.657;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="smem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArro