# All providers are optional. With these placeholders the complete game runs on local lore.
# Copy this file to .env. Never add real keys to source control or a VITE_* variable.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.8-flash
GEMINI_FAST_THINKING=minimal
GEMINI_SMART_THINKING=low
GEMINI_API_REVISION=2026-05-20

# Uses the AWS SDK credential chain / EC2 instance role when enabled.
# No AWS access key is required on EC2. For local use configure your usual AWS CLI profile.
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_FAST_MODEL=us.anthropic.claude-haiku-5-5
BEDROCK_SMART_MODEL=us.anthropic.claude-haiku-5-5
AWS_BEARER_TOKEN_BEDROCK=your-optional-bedrock-api-key

SUPERMEMORY_API_KEY=your-supermemory-api-key
SUPERMEMORY_NAMESPACE=mythic-strings-mantras
SUPERMEMORY_THRESHOLD=0.88

AI_PROVIDER_ORDER=gemini,bedrock
PROMPT_BUDGET_MS=2600
SUMMON_BUDGET_MS=25000
ATELIER_BUDGET_MS=30000
AI_PER_MINUTE=40
AI_GLOBAL_PER_MINUTE=120
AI_DAILY_LIMIT=1500
AI_SMART_DAILY_LIMIT=100
AI_CONCURRENCY=8

# Local server. The AWS deployer sets production values automatically.
HOST=127.0.0.1
PORT=8787
DATA_DIR=.data
STATIC_DIR=dist/client
AWS_REGION=us-east-1
DYNAMODB_TABLE=
TRUST_PROXY=false

# Optional stable guest signing key (32+ random bytes recommended).
# When blank, a private key is generated in DATA_DIR/session.key.
SESSION_SECRET=
# Set only for the CloudFront origin. The deployer generates this automatically.
ORIGIN_SECRET=
