{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Mythic Strings: one authoritative ARM server, DynamoDB, and HTTPS CloudFront with WebSocket forwarding",
  "Parameters": {
    "VpcId": { "Type": "AWS::EC2::VPC::Id" },
    "SubnetId": { "Type": "AWS::EC2::Subnet::Id" },
    "CloudFrontPrefixListId": { "Type": "String", "AllowedPattern": "pl-[a-z0-9]+" },
    "ArtifactBucket": { "Type": "String" },
    "ArtifactKey": { "Type": "String" },
    "EnvKey": { "Type": "String" },
    "BootstrapKey": { "Type": "String" },
    "OriginSecret": { "Type": "String", "NoEcho": true, "MinLength": 32 },
    "InstanceType": { "Type": "String", "Default": "t4g.small", "AllowedValues": ["t4g.small", "t4g.medium"] },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
    }
  },
  "Resources": {
    "GameTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "pk", "AttributeType": "S" }, { "AttributeName": "sk", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "pk", "KeyType": "HASH" }, { "AttributeName": "sk", "KeyType": "RANGE" }],
        "SSESpecification": { "SSEEnabled": true },
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true }
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "ec2.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "ManagedPolicyArns": [{ "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore" }],
        "Policies": [{
          "PolicyName": "MythicRuntime",
          "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Effect": "Allow", "Action": ["s3:GetObject"], "Resource": { "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/releases/*" } },
            { "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query"], "Resource": { "Fn::GetAtt": ["GameTable", "Arn"] } },
            { "Effect": "Allow", "Action": ["bedrock:InvokeModel"], "Resource": [
              { "Fn::Sub": "arn:${AWS::Partition}:bedrock:*::foundation-model/*" },
              { "Fn::Sub": "arn:${AWS::Partition}:bedrock:*:${AWS::AccountId}:inference-profile/*" }
            ] }
          ] }
        }]
      }
    },
    "InstanceProfile": { "Type": "AWS::IAM::InstanceProfile", "Properties": { "Roles": [{ "Ref": "InstanceRole" }] } },
    "OriginSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Only CloudFront origin-facing nodes may reach the game; administration uses SSM",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [{ "IpProtocol": "tcp", "FromPort": 8787, "ToPort": 8787, "SourcePrefixListId": { "Ref": "CloudFrontPrefixListId" } }]
      }
    },
    "GameInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": { "Ref": "AmiId" },
        "InstanceType": { "Ref": "InstanceType" },
        "IamInstanceProfile": { "Ref": "InstanceProfile" },
        "NetworkInterfaces": [{
          "DeviceIndex": "0", "AssociatePublicIpAddress": true,
          "SubnetId": { "Ref": "SubnetId" }, "GroupSet": [{ "Ref": "OriginSecurityGroup" }]
        }],
        "MetadataOptions": { "HttpTokens": "required", "HttpEndpoint": "enabled" },
        "CreditSpecification": { "CPUCredits": "standard" },
        "BlockDeviceMappings": [{ "DeviceName": "/dev/xvda", "Ebs": { "VolumeSize": 12, "VolumeType": "gp3", "Encrypted": true, "DeleteOnTermination": true } }],
        "Tags": [{ "Key": "Name", "Value": { "Fn::Sub": "${AWS::StackName}-game" } }],
        "UserData": { "Fn::Base64": { "Fn::Sub": "#!/bin/bash\nset -euo pipefail\ndnf install -y nodejs22 nodejs22-npm awscli2 tar gzip\naws s3 cp 's3://${ArtifactBucket}/${BootstrapKey}' /tmp/mythic-bootstrap.sh --region '${AWS::Region}' --only-show-errors\nbash /tmp/mythic-bootstrap.sh '${ArtifactBucket}' '${ArtifactKey}' '${EnvKey}' '${GameTable}' '${AWS::Region}'\n" } }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": { "Fn::Sub": "${AWS::StackName} - two-player shadow puppet duels" },
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [{
            "Id": "game",
            "DomainName": { "Fn::GetAtt": ["GameInstance", "PublicDnsName"] },
            "CustomOriginConfig": { "HTTPPort": 8787, "OriginProtocolPolicy": "http-only", "OriginReadTimeout": 60 },
            "OriginCustomHeaders": [{ "HeaderName": "X-Mythic-Origin", "HeaderValue": { "Ref": "OriginSecret" } }]
          }],
          "DefaultCacheBehavior": {
            "TargetOriginId": "game",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "PATCH", "POST", "DELETE"],
            "CachedMethods": ["GET", "HEAD"],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3",
            "Compress": true
          },
          "CacheBehaviors": [{
            "PathPattern": "/assets/*",
            "TargetOriginId": "game",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD"],
            "CachedMethods": ["GET", "HEAD"],
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "Compress": true
          }],
          "CustomErrorResponses": [
            { "ErrorCode": 502, "ErrorCachingMinTTL": 0 },
            { "ErrorCode": 503, "ErrorCachingMinTTL": 0 },
            { "ErrorCode": 504, "ErrorCachingMinTTL": 0 }
          ],
          "ViewerCertificate": { "CloudFrontDefaultCertificate": true }
        }
      }
    }
  },
  "Outputs": {
    "URL": { "Value": { "Fn::Sub": "https://${Distribution.DomainName}" } },
    "InstanceId": { "Value": { "Ref": "GameInstance" } },
    "TableName": { "Value": { "Ref": "GameTable" } },
    "DistributionId": { "Value": { "Ref": "Distribution" } }
  }
}
